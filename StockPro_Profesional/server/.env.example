# Copia este archivo a .env y reemplaza el token por un secreto aleatorio largo.
STOCKPRO_OWNER_TOKEN=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
STOCKPRO_TRIAL_DAYS=30
STOCKPRO_DB=/var/lib/stockpro/stockpro.db
# Orígenes exactos del panel de administración, separados por comas.
STOCKPRO_CORS_ORIGINS=http://localhost:8080
